# Copy this file to .env for local development (netlify dev / vite dev).
# For a deployed site, set these in your Netlify site's
# Site configuration → Environment variables instead.

# ── Frontend (VITE_ prefixed — bundled into the browser build, not secret) ──

# Shown in the nav bar, browser tab title, and Home page heading.
VITE_SITE_TITLE=Spirit Challenge

# What to call a member's group on the leaderboard (e.g. Team, House, Chapter).
VITE_GROUP_LABEL=Team

# Optional. Only used for the sign-in email placeholder/hint text
# (e.g. "acme.org" -> "you@acme.org"). Leave blank to show a generic example.
VITE_EMAIL_DOMAIN=

# Optional. Extra line shown in the footer.
VITE_FOOTER_TEXT=

# ── Backend (used only by Netlify functions — never exposed to the browser) ──

# Airtable Personal Access Token with access to your base.
AIRTABLE_API_KEY=

# The Base ID of your Airtable base (starts with "app...").
# See docs/airtable-schema.md for the required table/field structure.
AIRTABLE_BASE_ID=

# Cloudinary account used to store challenge proof photos.
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=

# Optional. Name of an *unsigned* Cloudinary upload preset. Defaults to
# "unsigned_upload" if unset — create a preset with that exact name, or
# set this to match whatever you named yours.
CLOUDINARY_UPLOAD_PRESET=
